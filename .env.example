# ============================================================
#  Sentinel Security Monitor — Windows Konfiguration
#  Kopiere/rename diese Datei zu: .env
# ============================================================

# ── VirusTotal API Key ───────────────────────────────────────
# Kostenlos holen: https://www.virustotal.com/gui/sign-in
# Avatar → API Key → kopieren
SENTINEL_VT_API_KEY=

# API Rate Limit (kostenlos = 4/min)
SENTINEL_VT_RATE_LIMIT=4
SENTINEL_VT_POLL_INTERVAL=15
SENTINEL_VT_POLL_MAX_ATTEMPTS=12

# ── Überwachter Ordner (leer = automatisch ~/Downloads) ──────
# Beispiele:
# SENTINEL_WATCH_PATH=C:\Users\Max\Downloads
# SENTINEL_WATCH_PATH=D:\Downloads
SENTINEL_WATCH_PATH=

# ── Datenpfade (leer = %USERPROFILE%\.sentinel) ──────────────
# SENTINEL_DB_PATH=C:\Users\Max\.sentinel\sentinel.db
# SENTINEL_REPORTS_DIR=C:\Users\Max\.sentinel\reports
# SENTINEL_QUARANTINE_DIR=C:\Users\Max\.sentinel\quarantine

# ── Dateifilter ──────────────────────────────────────────────
SENTINEL_MIN_FILE_SIZE=64
SENTINEL_MAX_UPLOAD_SIZE=33554432
